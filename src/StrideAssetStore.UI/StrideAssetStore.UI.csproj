<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Keep the original code namespace so both hosts (WASM + Photino) reuse types unchanged. -->
    <RootNamespace>StrideAssetStore.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrideAssetStore.Core\StrideAssetStore.Core.csproj" />
  </ItemGroup>

  <!-- This library is embedded in the WebAssembly storefront, so it must never gain filesystem or
       git code: that is what Core.Local is for, and it belongs to the CLI and the desktop app
       alone. A reference could arrive transitively and stay invisible until something throws in a
       browser, so fail the build instead. -->
  <Target Name="_ForbidCoreLocalReference" AfterTargets="ResolveReferences">
    <Error Condition="'%(ReferencePath.Filename)' == 'StrideAssetStore.Core.Local'"
           Text="$(MSBuildProjectName) must not reference StrideAssetStore.Core.Local: it runs in the browser, where there is no filesystem and no git." />
  </Target>

</Project>
