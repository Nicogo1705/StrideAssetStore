@inherits LayoutComponentBase
@implements IDisposable
@inject AppEnvironment Env
@inject UpdateService Updater
@inject AppInfo AppFacts
@inject RegistryOptions Registry
@inject ICliPublisher Cli
@inject IJSRuntime JS
@inject HttpClient Http
@inject AttentionState Attention
@using StrideAssetStore.App.Services

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="">
            <span class="brand-mark">◆</span>
            <span class="brand-text">Community Stride <strong>Asset Store</strong></span>
        </a>
        <span class="brand-tag">unofficial</span>
        <a class="brand-link" href="https://stride3d.net" target="_blank" rel="noopener">Stride website ↗</a>
        <nav class="app-nav">
            @if (Env.InstallAvailable)
            {
                <a href="setup" style="margin-right:1rem">Prerequisites@(_cliStatus is { ReadyToPublish: false } ? _dot("git or the GitHub CLI needs attention") : null)</a>
                <a href="projects" style="margin-right:1rem">My projects@(Attention.Current?.Projects > 0 ? _dot($"{Attention.Current.Projects} asset reference(s) outdated, broken or missing") : null)</a>
                <a href="assets" style="margin-right:1rem">My assets@(Attention.Current?.Assets > 0 ? _dot($"{Attention.Current.Assets} cached asset(s) outdated or broken") : null)</a>
            }
            <a href="manage" style="margin-right:1rem">Manage store assets</a>
            <a href="about" style="margin-right:1rem">About</a>
            <button type="button" class="theme-toggle" title="Toggle light/dark theme" aria-label="Toggle light/dark theme" @onclick="ToggleTheme">
                @(_theme == "light" ? "🌙" : "☀️")
            </button>
            @if (Env.IsLocal)
            {
                @* Renders server-side in the desktop app, so this is the HOST's OS. Hiding a
                   console window only exists on Windows — elsewhere the terminal is the user's. *@
                @* Links, not buttons: the handler keeps the page in place while the circuit is
                   alive, and the href stays as a working fallback when it isn't — a broken page
                   is precisely when quitting the app matters. *@
                @if (OperatingSystem.IsWindows())
                {
                    <a class="theme-toggle" href="console/toggle" aria-label="Toggle the console window" title="Hide / show the console window (remembered for the next start)"
                       @onclick="ToggleConsoleAsync" @onclick:preventDefault>🖥</a>
                }
                <a class="theme-toggle" href="app/quit" aria-label="Quit the desktop app" title="Quit the desktop app (stops the server process)"
                   @onclick="QuitAppAsync" @onclick:preventDefault>⏻</a>
            }
            @if (Env.Initialized && !Env.IsLocal)
            {
                @* A browser can open a page; it cannot start a process. So the site offers exactly
                   two things: the address of an app that is already answering, and the way to get
                   one that isn't. Starting, stopping, updating and controlling it all belong to the
                   tool, which behaves the same on the three platforms — unlike the protocol handler
                   this used to lean on, which only ever registered itself on Windows. *@
                @if (_localApp is { Running: true })
                {
                    <a class="btn-dl" href="http://localhost:5111" target="_blank" rel="noopener">▶ Open app</a>
                }
                else
                {
                    <a class="btn-dl" href="download">⬇ Get the app</a>
                }
            }
            @if (Env.Initialized)
            {
                @* A link, not a label: the update banner can be dismissed, and this is then the only
                   way back to what version anything on this machine is running. *@
                <a class="env @(Env.IsLocal ? "local" : "online")" href="status"
                   title="@(Env.IsLocal ? "Running the local desktop app — click for versions and updates" : "Browsing online — click for versions and updates")">
                    ● @(Env.IsLocal ? "Desktop app" : "Online")@(Updater.UpdateAvailable && !Updater.IsDevBuild ? _dot($"v{Updater.LatestVersion} is available") : null)
                </a>
            }
        </nav>
    </header>

    @* A newer release exists but carries nothing this machine can run — an unsupported platform,
       or archive names that changed since this build. Distinct from "still uploading": that one
       resolves by itself in minutes, this one never does. *@
    @if (Env.InstallAvailable && !Updater.IsDevBuild && Updater.NoBuildForThisPlatform && _dismissedUpdate != Updater.LatestVersion)
    {
        <div class="update-banner">
            <span>📦 <strong>v@(Updater.LatestVersion) is out</strong> — but it ships no build for this machine. Get it from the release page.</span>
            <span class="update-actions">
                @if (Updater.ReleaseUrl is not null)
                {
                    <a class="btn primary" href="@Updater.ReleaseUrl" target="_blank" rel="noopener">Release page</a>
                }
                <button type="button" class="banner-close" aria-label="Dismiss" title="Hide until the next release" @onclick="DismissUpdateAsync">✕</button>
            </span>
        </div>
    }

    @if (Env.InstallAvailable && !Updater.IsDevBuild && Updater.Publishing && _dismissedUpdate != Updater.LatestVersion)
    {
        <div class="update-banner">
            <span>⏳ <strong>v@(Updater.LatestVersion) is being published</strong> — the release workflow is still uploading the builds. Try again in a few minutes.</span>
            <span class="update-actions">
                @if (Updater.ReleaseUrl is not null)
                {
                    <a class="btn" href="@Updater.ReleaseUrl" target="_blank" rel="noopener">Release page</a>
                }
                <button type="button" class="banner-close" aria-label="Dismiss" title="Hide until the next release" @onclick="DismissUpdateAsync">✕</button>
            </span>
        </div>
    }

    @if (Env.InstallAvailable && !Updater.IsDevBuild && Updater.UpdateAvailable && _dismissedUpdate != Updater.LatestVersion)
    {
        <div class="update-banner">
            @* Updating is a terminal job on purpose: it must keep working when this UI doesn't,
               and it was precisely the in-app path that stayed broken for a month. *@
            <span>
                ⬆ <strong>Update available</strong> — v@(Updater.LatestVersion) is out (you're on
                v@(Updater.CurrentVersion))@(Updater.DownloadSize is { } dl ? $" · 📦 {FormatSize(dl)}" : "").
            </span>
            <span class="update-actions">
                <UpdateActions Status="_cliStatus" OnNotice="SetUpdateNotice" />
                @* Dismissing hides the banner until the next release — the status page keeps all of it. *@
                <a class="btn" href="status" title="Versions, updates and the tools this app uses">Details</a>
                <button type="button" class="banner-close" aria-label="Dismiss" title="Hide until the next release" @onclick="DismissUpdateAsync">✕</button>
            </span>
        </div>
    }

    @* What came of pressing an update button: the terminal opened, the tool is missing, nothing
       could be started. It outlives the click, so it is a banner rather than a flash of text. *@
    @if (_updateNotice is not null)
    {
        <div class="update-banner">
            <span>⬆ @((MarkupString)_updateNotice)</span>
            <span class="update-actions">
                <button type="button" class="banner-close" aria-label="Dismiss" title="Hide" @onclick="() => _updateNotice = null">✕</button>
            </span>
        </div>
    }

    @if (Env.InstallAvailable && _cliStatus is not null && !_cliStatus.ReadyToPublish)
    {
        <div class="update-banner">
            <span>🛠 <strong>Command-line tools</strong> — @(!_cliStatus.GitInstalled ? "git is missing — it is what installs assets" : !_cliStatus.GhInstalled ? "the GitHub CLI (gh) is missing — it is what opens pull requests" : "gh isn't signed in, so it can't open pull requests")</span>
            <span class="update-actions"><a class="btn primary" href="setup">Set them up</a></span>
        </div>
    }

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        <a href="@GitLinks.ReleasesLatest(AppFacts.Repo)" target="_blank" rel="noopener" class="ver-link">v@(Updater.CurrentVersion)</a>
        · MIT
        · <a href="@AppFacts.Repo" target="_blank" rel="noopener" title="App and storefront source">app ↗</a>
        · <a href="@($"https://github.com/{Registry.Owner}/{Registry.Repo}")" target="_blank" rel="noopener" title="Asset registry (index, certification, PRs)">registry ↗</a>
    </footer>
</div>

@code {
    private static RenderFragment _dot(string title) => @<span class="nav-dot" title="@title">●</span>;

    /// <summary>Where the update buttons report back — the banner's own line.</summary>
    private void SetUpdateNotice(string? notice) => _updateNotice = notice;

    private void OnAttentionChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Drops the subscription and the release poll. Without this the timer outlives the layout and
    /// keeps calling StateHasChanged on a component that is gone.
    /// </summary>
    public void Dispose()
    {
        Attention.Changed -= OnAttentionChanged;
        _publishingPoll?.Dispose();
        _publishingPoll = null;
    }

    private static string FormatSize(long bytes) => ByteSize.Format(bytes);

    private async Task ToggleConsoleAsync()
    {
        try
        {
            await Http.PostAsync("console/toggle", null);
        }
        catch
        {
            // Endpoint only exists in the desktop app; nothing to do if it isn't there.
        }
    }

    /// <summary>Where the update buttons report back — the banner above renders it.</summary>
    private string? _updateNotice;

    private async Task QuitAppAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Quit the Community Stride Asset Store app?"))
        {
            return;
        }

        try
        {
            await Http.PostAsync("app/quit", null);
        }
        catch
        {
            // The server may already be gone — which is the goal.
        }

        // Close the tab too. Browsers only honor window.close() for tabs without navigation
        // history (which is the normal case: the app opened this tab itself) — when they
        // refuse, leave a clear end-of-life message instead of a dead spinner.
        try
        {
            await JS.InvokeVoidAsync("eval",
                "setTimeout(() => { window.close(); setTimeout(() => {" +
                " document.body.innerHTML = '<div style=\"font-family:system-ui;display:grid;place-items:center;height:100vh;color:#889\">" +
                "App stopped — you can close this tab.</div>'; }, 400); }, 250);");
        }
        catch
        {
            // Circuit already torn down — the browser shows its own disconnect state.
        }
    }

    private CliStatus? _cliStatus;
    private string _theme = "dark";

    // Local desktop-app presence, detected from the online site via a localhost ping. Only the
    // running flag is used now: whether it is also up to date is the app's own business, and it
    // says so in its own banner rather than through a version comparison made from a web page.
    private sealed record LocalAppStatus(bool Running, string? Version);
    private LocalAppStatus? _localApp;

    // The version the user dismissed the update banner for — it reappears for the NEXT release.
    private string? _dismissedUpdate;

    private async Task ToggleTheme()
    {
        _theme = _theme == "light" ? "dark" : "light";
        await JS.InvokeVoidAsync("assetStoreEnv.setTheme", _theme);
    }

    private async Task DismissUpdateAsync()
    {
        _dismissedUpdate = Updater.LatestVersion;
        await JS.InvokeVoidAsync("assetStoreEnv.setPref", "dismissed.update", _dismissedUpdate);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _theme = await JS.InvokeAsync<string>("assetStoreEnv.getTheme");
                _dismissedUpdate = await JS.InvokeAsync<string?>("assetStoreEnv.getPref", "dismissed.update");
            }
            catch
            {
                // cosmetic — keep the defaults if interop isn't available
            }

            await Env.InitializeAsync();
            StateHasChanged();

            // Only the local/desktop build can install updates in place or use the CLI; check there.
            if (Env.InstallAvailable)
            {
                await Updater.CheckAsync();
                StartPublishingRecheck();
                if (Cli.Supported)
                {
                    _cliStatus = await Cli.CheckAsync();
                    if (Env.IsLocal)
                    {
                        Attention.Changed += OnAttentionChanged;
                        _ = Attention.RefreshAsync();
                    }
                }

                StateHasChanged();
            }
            else if (!Env.IsLocal)
            {
                // Online: swap "Download app" for "Open/Start app" when the desktop app is around.
                await DetectLocalAppAsync();
                StateHasChanged();
            }
        }
    }

    private System.Threading.Timer? _publishingPoll;

    /// <summary>
    /// While a new release is still uploading its zips ("publishing"), re-run the update check
    /// every minute so the banner flips to the real update offer by itself — without this the
    /// once-per-session check never re-fires and the "try again in a few minutes" is a dead end.
    /// </summary>
    private void StartPublishingRecheck()
    {
        if (!Updater.Publishing || _publishingPoll is not null)
        {
            return;
        }

        _publishingPoll = new System.Threading.Timer(async _ =>
        {
            try
            {
                await Updater.CheckAsync();
                if (!Updater.Publishing)
                {
                    _publishingPoll?.Dispose();
                    _publishingPoll = null;
                }

                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                // Best-effort; the next tick retries.
            }
        }, null, 60_000, 60_000);
    }

    private async Task DetectLocalAppAsync()
    {
        try
        {
            _localApp = await JS.InvokeAsync<LocalAppStatus>("assetStoreEnv.detectApp");
        }
        catch
        {
            // Detection is cosmetic — the "Get the app" link is the right answer either way.
        }
    }
}
