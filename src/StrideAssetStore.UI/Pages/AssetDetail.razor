@page "/asset"
@page "/a/{RouteId}"
@implements IDisposable
@using System.Text.Json
@inject CatalogState State
@inject AppEnvironment Env
@inject HttpClient Http
@inject RegistryOptions Registry
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ICliRunner Runner

@if (State.Loading)
{
    <p class="notice">Loading…</p>
}
else if (Asset is null)
{
    <a class="back" href="">← Back</a>
    <p class="notice error">Asset '@AssetId' was not found in the catalog.</p>
}
else
{
    var m = Asset.Manifest;
    var v = Asset.Latest;
    <PageTitle>@m.Name — Community Stride Asset Store</PageTitle>

    <a class="back" href="">← Back to catalog</a>

@if (Asset.Deprecated is { } deprecated)
{
    <div class="cache-note" style="border-color:var(--warn)">
        ⚠ <strong>Deprecated</strong>@(string.IsNullOrEmpty(deprecated.Reason) ? "" : $" — {deprecated.Reason}")
        @if (!string.IsNullOrEmpty(deprecated.Successor))
        {
            <text> · use <a href="@($"a/{Uri.EscapeDataString(deprecated.Successor!)}")">@deprecated.Successor</a> instead.</text>
        }
    </div>
}

    <div class="detail">
        <div class="detail-head">
            <div class="detail-thumb">
                @(m.Name.Length > 0 ? m.Name[..1].ToUpperInvariant() : "?")
                @if (ThumbUrl is not null)
                {
                    <img class="thumb-img" src="@ThumbUrl" alt="" onload="this.style.display=''" onerror="this.style.display='none'" />
                }
            </div>
            <div>
                <h1>@m.Name</h1>
                <div class="sub">
                    @m.Id · by
                    @for (var i = 0; i < m.Authors.Count; i++)
                    {
                        var a = m.Authors[i];
                        @(i > 0 ? ", " : " ")
                        <a href="@($"?author={Uri.EscapeDataString(a.Name)}")" title="@($"All assets by {a.Name}")">@a.Name</a>
                        @if (!string.IsNullOrWhiteSpace(a.Url))
                        {
                            <a href="@a.Url" target="_blank" rel="noopener" title="External profile">↗</a>
                        }
                    }
                </div>
                <div class="card-meta" style="margin-top:.5rem">
                    <span class="badge cat">@m.Category</span>
                    @if (v.DetectedStrideVersion is not null)
                    {
                        <span class="badge stride">Stride @v.DetectedStrideVersion</span>
                    }
                    @if (Asset.Certified.Count > 0)
                    {
                        <span class="badge certified"
                              title="Certified: this version was reviewed by the registry maintainers and is pinned to an immutable commit.">
                            ✔ certified
                        </span>
                    }
                    @if (m.Nuget is not null)
                    {
                        <span class="badge nuget">NuGet</span>
                    }
                    @if (Asset.Stars is { } stars)
                    {
                        <span class="badge stars" title="GitHub stars">★ @stars</span>
                    }
                    @if (Asset.Forks is { } forks)
                    {
                        <span class="badge" title="GitHub forks">⑂ @forks</span>
                    }
                </div>
                <div style="margin-top:.6rem; display:flex; gap:.5rem; flex-wrap:wrap">
                    <a class="btn" href="@Asset.Repo" target="_blank" rel="noopener">★ Star on GitHub</a>
                    <a class="btn" href="@GitLinks.Forks(Asset.Repo)" target="_blank" rel="noopener">⑂ View forks</a>
                    <a class="btn" href="@GitLinks.NewIssue(Asset.Repo)" target="_blank" rel="noopener">⚠ Create an issue</a>
                    <a class="btn" href="@GitLinks.Releases(Asset.Repo)" target="_blank" rel="noopener">🏷 Changelog</a>
                    @if (Env.Initialized && !Env.IsLocal)
                    {
                        <button type="button" class="btn" @onclick="ShareAsync"
                                title="Copy a link to this asset">
                            @(_shared ? "✓ Link copied" : "🔗 Share")
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (_readme is { } readmeHtml)
        {
            <div class="readme">@readmeHtml</div>
        }
        else
        {
            <p>@m.Description</p>
        }

        @if (MediaUrls.Count > 0)
        {
            <section class="gallery">
                @for (var i = 0; i < MediaUrls.Count; i++)
                {
                    var idx = i;
                    var url = MediaUrls[idx];
                    <button type="button" class="shot" @onclick="() => OpenLightbox(idx)" title="Open">
                        @if (IsVideo(url))
                        {
                            <video src="@url" muted preload="metadata"></video>
                            <span class="shot-play">▶</span>
                        }
                        else
                        {
                            <img src="@url" loading="lazy" alt="Media @(idx + 1)" onerror="this.closest('.shot').style.display='none'" />
                        }
                    </button>
                }
            </section>
        }

        @if (Asset.ValidationStatus is not "ok")
        {
            var isError = Asset.ValidationStatus is "error" or "unavailable";
            <div class="validation @(isError ? "error" : "warning")">
                <div class="validation-head">
                    <span class="vbig">@(isError ? "⛔" : "⚠️")</span>
                    <span>@(isError ? "Validation failed — this asset may not build" : "This asset has warnings")</span>
                </div>
                @if (ParsedMessages().Count > 0)
                {
                    <ul class="validation-list">
                        @foreach (var line in ParsedMessages())
                        {
                            <li class="vline @(line.IsError ? "err" : "warn")">
                                <span class="vico">@(line.IsError ? "✗" : "⚠")</span>
                                <span><span class="vcode">@line.Code</span> @line.Text</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (_fileTree is not null)
        {
            <section>
                <h2>Files (@_fileCount)</h2>
                <p class="install-hint">
                    The asset's <span class="mono">AssetData/</span> at <span class="mono">@ActiveRef</span> — this is the folder
                    installing brings into your project.
                </p>
                <div class="filetree">
                    @RenderNode(_fileTree)
                </div>
            </section>
        }

        <section>
            <h2>Add to your project</h2>

            <label class="field" style="margin-bottom:.35rem">Version
                <select class="ipt" @bind="_versionRef" @bind:after="LoadRepoDataAsync">
                    <option value="@Asset.Latest.Ref">latest — @Asset.Latest.Ref branch (rolling)</option>
                    @foreach (var ver in Asset.Versions)
                    {
                        <option value="@ver.Tag">@ver.Version — tag@(IsCertified(ver.Commit) ? " ✓ certified" : "")</option>
                    }
                </select>
            </label>
            <p class="install-hint" style="margin-bottom:.7rem">
                @if (OnLatest)
                {
                    <text>Tracking the <strong>@Asset.Latest.Ref</strong> branch — always its newest commit (<span class="mono">@Short(ActiveCommit)</span>). A branch can move at any time; pick a tag for a version that stays put.</text>
                }
                else
                {
                    <text>Tag <strong>@_versionRef</strong> — pinned at <span class="mono">@Short(ActiveCommit)</span>.</text>
                    @if (IsCertified(ActiveCommit))
                    {
                        <span class="badge certified" style="margin-left:.4rem">✓ certified</span>
                    }
                    else
                    {
                        <text> (not certified)</text>
                    }
                }
            </p>

            @* Ordered by how much of the work is done for you: the app installs it, the tool does
               the same from a terminal, git leaves you to wire the reference yourself, and the
               package is only there for assets that publish one. *@
            <div class="modes" role="tablist">
                <button class="mode @(_view == "install" ? "active" : "")" role="tab" aria-selected="@(_view == "install")"
                        @onclick='() => _view = "install"'>⤓ Install with the app</button>
                <button class="mode @(_view == "cli" ? "active" : "")" role="tab" aria-selected="@(_view == "cli")"
                        @onclick='() => _view = "cli"'>⌨ Command line</button>
                <button class="mode @(_view == "source" ? "active" : "")" role="tab" aria-selected="@(_view == "source")"
                        @onclick='() => _view = "source"'>Git &amp; ProjectReference</button>
                <button class="mode @(_view == "nuget" ? "active" : "") @(m.Nuget is null ? "disabled" : "")"
                        role="tab" aria-selected="@(_view == "nuget")"
                        disabled="@(m.Nuget is null)"
                        title="@(m.Nuget is null ? "This asset is not published on NuGet" : "")"
                        @onclick='() => { if (m.Nuget is not null) _view = "nuget"; }'>
                    NuGet package
                </button>
            </div>

            @* One box for every tab, so the panel has a visible beginning and end whichever one is
               selected — the tabs alone left the content floating against the page. *@
            <div class="mode-panel">

            @if (_view == "install")
            {
                @if (Env.InstallAvailable)
                {
                    <div class="install-cta plain">
                        <a class="btn primary" href="@($"projects/install?id={Uri.EscapeDataString(Asset.Id)}&mode={DefaultImport}&ref={Uri.EscapeDataString(ActiveRef)}")">⤓ Install…</a>
                        <span class="install-hint">Download it for this machine, or add it to a project as
                            <code>&lt;ProjectReference&gt;</code>@(m.Nuget is not null ? " or a NuGet package" : "") — chosen on the next screen.</span>
                    </div>
                }
                else
                {
                    @* Browsing online: nothing here can reach a program on your machine, so the
                       two honest offers are the tool's command — which the Command line tab has,
                       with this asset's id already in it — and the app itself. *@
                    <div class="install-cta plain">
                        <button type="button" class="btn primary" @onclick='() => _view = "cli"'>⌨ Show the command</button>
                        <a class="btn" href="download">⬇ Get the desktop app</a>
                        <span class="install-hint">
                            <span class="mono">strideassetstore add @Asset.Id</span> installs it from a terminal.
                            Or wire it by hand from the <strong>Git &amp; ProjectReference</strong>@(m.Nuget is not null ? " / NuGet" : "") tab.
                        </span>
                    </div>
                }
            }
            else if (_view == "cli")
            {
                @* Someone who lives in a terminal still browses the store to find things. This tab
                   is the bridge: the command for what the version picker above is showing, aimed
                   at a project of theirs, without retyping an id that is long on purpose. *@
                <p class="mode-desc">
                    Install it with the <span class="mono">strideassetstore</span> tool, from a terminal.
                    Same cache and same project reference as the app —
                    <a href="setup">how to get the tool</a>.
                </p>

                @if (Runner.CanRun && Runner.KnownProjects.Count > 0)
                {
                    <label class="field" style="margin-bottom:.5rem">Into
                        <select class="ipt" @bind="_cliTarget" @bind:after="() => _cliNotice = null">
                            <option value="">the folder the command runs from</option>
                            @foreach (var project in Runner.KnownProjects)
                            {
                                <option value="@project.Path">@project.Name</option>
                            }
                        </select>
                    </label>
                }

                <div class="cmd">
                    <code>@CliAddCommand</code>
                    <button class="btn" @onclick="() => Copy(CliAddCommand)">Copy</button>
                    @if (Runner.CanRun)
                    {
                        <button type="button" class="btn primary" disabled="@_cliRunning" @onclick="RunCliAddAsync">▶ Run it</button>
                    }
                </div>

                @if (Runner.CanRun && _cliTarget.Length == 0)
                {
                    @* `add` resolves the solution from the current directory, and a terminal opened
                       from here starts wherever the app did — which is not the user's game. *@
                    <p class="install-hint">
                        Pick a project above, or run the command yourself from your game's folder — otherwise it
                        has no solution to install into.
                    </p>
                }

                @if (_cliNotice is not null)
                {
                    <p class="install-hint">@((MarkupString)_cliNotice)</p>
                }

                <p class="install-hint" style="margin-top:.6rem">
                    <span class="mono">strideassetstore info @ShellArg.Quote(Asset.Id)</span> lists every published version;
                    <span class="mono">strideassetstore remove @ShellArg.Quote(Asset.Id)</span> takes it back out.
                </p>
            }
            else if (_view == "nuget" && m.Nuget is not null)
            {
                <p class="mode-desc">Reference the published package — no source is cloned.</p>
                <div class="cmd">
                    <code>@NugetCommand</code>
                    <button class="btn" @onclick="() => Copy(NugetCommand)">Copy</button>
                </div>
                @* The version picker above drives this tab too, rather than being quietly ignored:
                   the store's convention is that a published asset gives its git tag and its NuGet
                   package the same number. Said out loud here because it is the authors' half of
                   the bargain — break it and this command asks for a version nobody published. *@
                <p class="install-hint">
                    @if (OnLatest)
                    {
                        <text>No version pinned — NuGet resolves the newest published package. Pick a tag above to pin one.</text>
                    }
                    else
                    {
                        <text>Pinned to <strong>@NugetVersion</strong>, the number of the tag picked above: an asset publishes its
                        package under the same number as its tag.</text>
                    }
                </p>
            }
            else
            {
                <p class="mode-desc">Clone the source and add a <code>&lt;ProjectReference&gt;</code> — you can compile and tweak it locally.</p>

                <div class="install-grid">
                    <div class="cmd">
                        <code>@CloneCommand</code>
                        <button class="btn" @onclick="() => Copy(CloneCommand)">Copy</button>
                    </div>

                    <div class="cmd">
                        <a class="btn" href="@GitLinks.ArchiveZip(Asset.Repo, ActiveCommit)">⬇ Download .zip</a>
                        <span class="install-hint">pinned at <span class="mono">@Short(ActiveCommit)</span></span>
                    </div>
                </div>
            }
            </div>
        </section>

        <section>
            <h2>Details</h2>
            <div class="kv">
                <span class="k">License</span><span>@m.License</span>
                <span class="k">Stride version</span><span>@(v.DetectedStrideVersion ?? "unknown")@LatestOnly</span>
                <span class="k">.NET</span><span>@(v.TargetFramework ?? "unknown")@LatestOnly</span>
                <span class="k">Default import</span><span>@(m.DefaultImport ?? "local")</span>
                <span class="k">Repository</span><span><a href="@GitLinks.TreeAtCommit(Asset.Repo, ActiveCommit)" target="_blank" rel="noopener">@Asset.Repo</a></span>
                <span class="k">Pinned commit</span><span class="mono">@ActiveCommit</span>
                <span class="k">Content hash</span><span class="mono">@ShortHash(v.ContentHash)@LatestOnly</span>
                <span class="k">Size</span><span>@FormatSize(v.SizeBytes)@LatestOnly</span>
                @if (m.Tags.Count > 0)
                {
                    <span class="k">Tags</span>
                    <span class="card-tags">
                        @foreach (var tag in m.Tags)
                        {
                            <a class="tag-chip" href="@($"?tag={Uri.EscapeDataString(tag)}")">#@tag</a>
                        }
                    </span>
                }
                @if (v.ResolvedDependencies.Count > 0)
                {
                    <span class="k">Dependencies</span>
                    <span>
                        @foreach (var dep in v.ResolvedDependencies)
                        {
                            <a href="@($"a/{Uri.EscapeDataString(dep)}")">@dep</a> <text> </text>
                        }
                    </span>
                }
            </div>
        </section>

        @if (v.ExternalDependencies.Count > 0)
        {
            <section>
                <h2>External dependencies</h2>
                <p class="install-hint">NuGet packages referenced by the project on <span class="mono">@Asset.Latest.Ref</span>. Store assets are listed under Dependencies.</p>
                <div class="extdeps">
                    @foreach (var pkg in v.ExternalDependencies)
                    {
                        <div class="extdep">
                            <span class="mono extdep-name">@pkg.Name</span>
                            <span class="mono extdep-ver">@(pkg.Version ?? "—")</span>
                        </div>
                    }
                </div>
            </section>
        }

        @if (Asset.Certified.Count > 0)
        {
            var ordered = CertifiedNewestFirst;
            <section>
                <h2>Certified versions</h2>
                <div class="kv">
                    @for (var i = 0; i < ordered.Count; i++)
                    {
                        var c = ordered[i];
                        var previous = i + 1 < ordered.Count ? ordered[i + 1] : null;
                        <span class="k">v@(c.Version)</span>
                        <span>
                            <span class="mono">@Short(c.Commit) @(c.CertifiedAt is not null ? $"· {c.CertifiedAt}" : "")</span>
                            @if (previous is not null)
                            {
                                @* Answers "should I update?" — the commit diff since the previous certified version. *@
                                <text> · </text><a href="@GitLinks.Compare(Asset.Repo, previous.Commit, c.Commit)"
                                                   target="_blank" rel="noopener">what changed since v@(previous.Version) ↗</a>
                            }
                        </span>
                    }
                </div>
            </section>
        }

        @if (SimilarAssets.Count > 0)
        {
            <section>
                <h2>Similar assets</h2>
                <div class="grid">
                    @foreach (var similar in SimilarAssets)
                    {
                        @* Without OnTagClick, the chips' "Filter by #x" title is a lie: stopPropagation
                           eats the click and the unassigned callback does nothing. *@
                        <AssetCard Asset="similar" @key="similar.Id" OnTagClick="FilterByTag" />
                    }
                </div>
            </section>
        }

        @if (Env.Initialized && !Env.IsLocal)
        {
            <section>
                <h2>Badge for your README</h2>
                <p class="install-hint">
                    Asset author? Add this badge to your README:
                    <img src="@BadgeImageUrl" alt="Available on the Community Stride Asset Store" style="vertical-align:middle" />
                </p>
                <div style="display:flex; gap:.5rem; align-items:center">
                    <code class="mono" style="font-size:.75rem; overflow-x:auto; white-space:nowrap">@BadgeMarkdown</code>
                    <button type="button" class="btn" @onclick="CopyBadgeAsync">@(_badgeCopied ? "✓" : "Copy")</button>
                </div>
            </section>
        }

        <p class="install-hint" style="margin-top:1.4rem">
            Something wrong with this asset?
            <a href="@GitLinks.NewIssue(Asset.Repo)" target="_blank" rel="noopener">Open an issue with its author</a>
            — a bug or a wrong description is theirs to fix. For a licensing, security or impersonation
            problem, use the registry's
            <a href="@GitLinks.ReportAsset(Registry.Owner, Registry.Repo, Asset.Id, Asset.Repo)" target="_blank" rel="noopener">🚩 takedown form</a>.
        </p>

        @if (_lightbox is { } li && li >= 0 && li < MediaUrls.Count)
        {
            @* Focusable and keyboard-driven: it is a dialog, and it used to be a div you could only
               leave with the mouse. @ref + focus on open so Escape and the arrows reach it. *@
            <div class="lightbox" role="dialog" aria-modal="true" aria-label="@MediaName(li)"
                 tabindex="-1" @ref="_lightboxElement" @onkeydown="OnLightboxKey" @onclick="CloseLightbox">
                <button class="lb-nav prev" @onclick:stopPropagation="true" @onclick="PrevShot"
                        title="Previous" aria-label="Previous image">‹</button>
                @if (IsVideo(MediaUrls[li]))
                {
                    <video class="lb-img" src="@MediaUrls[li]" controls autoplay @onclick:stopPropagation="true"></video>
                }
                else
                {
                    <img class="lb-img" src="@MediaUrls[li]" alt="" @onclick:stopPropagation="true" />
                }
                <button class="lb-nav next" @onclick:stopPropagation="true" @onclick="NextShot"
                        title="Next" aria-label="Next image">›</button>
                <button class="lb-close" @onclick="CloseLightbox" title="Close" aria-label="Close">✕</button>
                <div class="lb-caption" @onclick:stopPropagation="true">
                    <span class="lb-name">@MediaName(li)</span>
                    <span class="lb-count">@(li + 1) / @MediaUrls.Count</span>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "id")]
    public string? Id { get; set; }

    /// <summary>Path form (/a/{id}) — the shareable URL whose static snapshot carries the OG
    /// meta tags, so pasting the address bar into Discord renders a preview card.</summary>
    [Parameter]
    public string? RouteId { get; set; }

    private string? AssetId => RouteId ?? Id;

    private string? _versionRef;
    private string _view = "install";
    private string _cliTarget = "";
    private bool _cliRunning;
    private string? _cliNotice;
    private int? _lightbox;
    private ElementReference _lightboxElement;
    private bool _focusLightbox;

    private IndexedAsset? Asset => string.IsNullOrEmpty(AssetId) ? null : State.Find(AssetId);

    private IReadOnlyList<IndexedCertifiedVersion> CertifiedNewestFirst =>
        Asset is null
            ? []
            : Asset.Certified
                .OrderByDescending(c => StrideVersionMatcher.Parse(c.Version) ?? new Version(0, 0))
                .ToList();

    /// <summary>Up to 3 other catalog assets ranked by tag overlap (then stars).</summary>
    private IReadOnlyList<IndexedAsset> SimilarAssets
    {
        get
        {
            if (Asset is not { } current || State.Catalog is not { } catalog)
            {
                return [];
            }

            return catalog.Assets
                .Where(a => !string.Equals(a.Id, current.Id, StringComparison.Ordinal))
                .Select(a => (Asset: a, Shared: a.Manifest.Tags.Intersect(current.Manifest.Tags, StringComparer.OrdinalIgnoreCase).Count()))
                .Where(x => x.Shared > 0)
                .OrderByDescending(x => x.Shared)
                .ThenByDescending(x => x.Asset.Stars ?? -1)
                .Take(3)
                .Select(x => x.Asset)
                .ToList();
        }
    }

    private IReadOnlyList<string> MediaUrls =>
        Asset is null
            ? []
            : Asset.Manifest.Media
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Select(s => GitLinks.RawRepoFile(Asset.Repo, Asset.Latest.Commit, s))
                .ToList();

    private static readonly string[] VideoExtensions = [".mp4", ".webm", ".ogg", ".ogv", ".mov", ".m4v"];

    private static bool IsVideo(string url)
    {
        var path = url.Split('?', '#')[0];
        return VideoExtensions.Any(ext => path.EndsWith(ext, StringComparison.OrdinalIgnoreCase));
    }

    private void OpenLightbox(int index)
    {
        _lightbox = index;
        _focusLightbox = true; // focus after render, or the key handler never sees anything
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLightbox)
        {
            _focusLightbox = false;
            try
            {
                await _lightboxElement.FocusAsync();
            }
            catch
            {
                // The lightbox closed between the render and this callback — nothing to focus.
            }
        }
    }

    private void OnLightboxKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape": CloseLightbox(); break;
            case "ArrowRight": NextShot(); break;
            case "ArrowLeft": PrevShot(); break;
        }
    }

    private void CloseLightbox() => _lightbox = null;

    private void NextShot()
    {
        if (_lightbox is { } i && MediaUrls.Count > 0)
        {
            _lightbox = (i + 1) % MediaUrls.Count;
        }
    }

    private void PrevShot()
    {
        if (_lightbox is { } i && MediaUrls.Count > 0)
        {
            _lightbox = (i - 1 + MediaUrls.Count) % MediaUrls.Count;
        }
    }

    // Which import the install page should open with — NuGet only when the asset prefers it and publishes a package.
    private string DefaultImport =>
        Asset?.Manifest is { Nuget: not null, DefaultImport: "nuget" } ? "nuget" : "local";

    private string ActiveRef => _versionRef ?? Asset!.Latest.Ref;

    /// <summary>
    /// Marks a value the catalog only records for <c>latest</c>. Tag entries carry a version, a tag and
    /// a commit and nothing else, so claiming these follow the selector would be inventing data.
    /// </summary>
    private MarkupString LatestOnly => OnLatest
        ? new MarkupString("")
        : new MarkupString($" <span class=\"install-hint\">(on {System.Net.WebUtility.HtmlEncode(Asset!.Latest.Ref)})</span>");

    private string ActiveCommit =>
        _versionRef is null || _versionRef == Asset!.Latest.Ref
            ? Asset!.Latest.Commit
            : Asset!.Versions.FirstOrDefault(v => v.Tag == _versionRef)?.Commit ?? Asset.Latest.Commit;

    private bool OnLatest => _versionRef is null || _versionRef == Asset!.Latest.Ref;

    private static string Short(string commit) => commit.Length >= 7 ? commit[..7] : commit;

    private static string ShortHash(string? hash) =>
        string.IsNullOrEmpty(hash) ? "-" : hash.Length >= 16 ? hash[..16] + "…" : hash;

    /// <summary>File name of the media item at <paramref name="index"/> (from its URL), for the lightbox caption.</summary>
    private string MediaName(int index)
    {
        if (index < 0 || index >= MediaUrls.Count)
        {
            return "";
        }

        var path = MediaUrls[index].Split('?', '#')[0];
        var name = path[(path.LastIndexOf('/') + 1)..];
        return Uri.UnescapeDataString(name);
    }

    private string CloneCommand => $"git clone --branch {ActiveRef} {Asset!.Repo}";

    /// <summary>
    /// The tool command for what the version picker is showing. A tag becomes <c>--version</c>
    /// rather than <c>--ref</c>: it is the same commit, and it is the form that keeps meaning the
    /// same thing when the command is pasted into a script or a README.
    /// </summary>
    private string CliAddCommand
    {
        get
        {
            // Escaped, not trusted: the id is validated by the registry, but a version label is
            // whatever an author named a git tag — and this string is handed to a shell. A tag
            // called `1.0 & something` would otherwise run `something` as a second command.
            var command = $"strideassetstore add {ShellArg.Quote(Asset!.Id)}";
            if (!OnLatest)
            {
                var tag = _versionRef!;
                var version = Asset.Versions.FirstOrDefault(v => v.Tag == tag)?.Version ?? tag;
                command += $" --version {ShellArg.Quote(version)}";
            }

            // Only when the asset would be cloned by default and can also be a package: the tab is
            // about installing what this page describes, and that is the source unless it says so.
            if (Asset.Manifest.Nuget is not null && DefaultImport == "nuget")
            {
                command += " --nuget";
            }

            return _cliTarget.Length > 0 ? $"{command} --target {ShellArg.Quote(_cliTarget)}" : command;
        }
    }

    /// <summary>
    /// The package version this page offers: the number of the tag picked in the version selector,
    /// or the manifest's own while following the rolling branch. One selector, both import modes —
    /// which only works because tag and package version are the same number by convention.
    /// </summary>
    private string? NugetVersion =>
        OnLatest
            ? Asset!.Manifest.Nuget?.PackageVersion
            : Asset!.Versions.FirstOrDefault(v => v.Tag == _versionRef)?.Version ?? Asset.Manifest.Nuget?.PackageVersion;

    private string NugetCommand => GitLinks.AddPackageCommand(Asset!.Manifest.Nuget!.PackageId, NugetVersion);

    private async Task RunCliAddAsync()
    {
        _cliRunning = true;
        _cliNotice = null;
        try
        {
            // The terminal opens in the solution's folder as well as carrying --target: a command
            // that is copied out of that window later still has to work where it landed.
            var folder = _cliTarget.Length > 0 ? Path.GetDirectoryName(_cliTarget) : null;
            var result = await Runner.RunAsync(CliAddCommand["strideassetstore ".Length..], folder);
            _cliNotice = result switch
            {
                { Opened: true } => "<strong>Running in the terminal.</strong> Its window stays open when the command finishes.",
                { ToolMissing: true } =>
                    "<strong>The tool isn't installed.</strong> Run <code>dotnet tool install -g StrideAssetStore</code> first — see <a href=\"setup\">Prerequisites</a>.",
                _ => "<strong>Couldn't open a terminal.</strong> Copy the command and run it yourself.",
            };
        }
        finally
        {
            _cliRunning = false;
        }
    }

    private sealed record VLine(bool IsError, string Code, string Text);

    private List<VLine> ParsedMessages()
    {
        var list = new List<VLine>();
        foreach (var m in Asset!.ValidationMessages)
        {
            var isError = m.StartsWith("[Error]", StringComparison.Ordinal);
            var body = m.StartsWith('[') && m.Contains(']') ? m[(m.IndexOf(']') + 1)..].Trim() : m;
            var colon = body.IndexOf(": ", StringComparison.Ordinal);
            list.Add(new VLine(isError, colon > 0 ? body[..colon] : "", colon > 0 ? body[(colon + 2)..] : body));
        }

        return list;
    }

    private bool IsCertified(string commit) =>
        Asset!.Certified.Any(c => string.Equals(c.Commit, commit, StringComparison.Ordinal));

    private MarkupString? _readme;
    private TreeNode? _fileTree;
    private int _fileCount;
    private string? _loadedCommit;

    private sealed class TreeNode
    {
        public string Name { get; init; } = "";
        public bool IsFolder { get; init; }
        public long Size { get; set; }
        public SortedDictionary<string, TreeNode> Children { get; } = new(StringComparer.OrdinalIgnoreCase);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reset per-asset selections when navigating between assets.
        _versionRef = null;
        _badgeCopied = false;
        _shared = false;
        _view = "install";
        _lightbox = null;
        await LoadRepoDataAsync();
    }

    /// <summary>Fetches the asset's README (rendered) and its AssetData/ file list at the pinned commit.</summary>
    private bool _shared;
    private bool _badgeCopied;

    // shields.io static badge (no service of our own): label + accent color.
    private const string BadgeImageUrl =
        "https://img.shields.io/badge/Community_Stride_Asset_Store-install-5b8def";

    private string BadgeMarkdown =>
        $"[![Available on the Community Stride Asset Store]({BadgeImageUrl})]({Nav.BaseUri}a/{Uri.EscapeDataString(Asset?.Id ?? "")}/)";

    /// <summary>Sends a tag chip on a "Similar assets" card to the catalog, which is where filtering lives.</summary>
    private void FilterByTag(string tag) => Nav.NavigateTo($"?tag={Uri.EscapeDataString(tag)}");

    private async Task CopyBadgeAsync()
    {
        _badgeCopied = await Env.CopyAsync(BadgeMarkdown);
    }

    /// <summary>Copies the static OG snapshot URL (a/&lt;id&gt;/) — unlike the SPA route, that link
    /// renders a preview card when pasted on Discord/Twitter (no SSR in Blazor WASM).</summary>
    private async Task ShareAsync()
    {
        if (Asset is null)
        {
            return;
        }

        _shared = await Env.CopyAsync($"{Nav.BaseUri}a/{Uri.EscapeDataString(Asset.Id)}/");
    }

    private async Task LoadRepoDataAsync()
    {
        var asset = Asset;
        if (asset is null)
        {
            _readme = null;
            _fileTree = null;
            _fileCount = 0;
            _loadedCommit = null;
            return;
        }

        var commit = ActiveCommit; // follow the selected version, not always latest
        if (_loadedCommit == commit)
        {
            return; // already loaded for this commit
        }

        _loadedCommit = commit;
        _readme = null;
        _fileTree = null;
        _fileCount = 0;

        // README.md → rendered Markdown (falls back to the short description if absent).
        try
        {
            var markdown = await Http.GetStringAsync(GitLinks.RawRepoFile(asset.Repo, commit, "README.md"));

            // A slower request for a version the user has since moved away from must not overwrite
            // what is on screen: switching main → v1.0.0 → main could leave the tag's README under
            // the branch's heading.
            if (_loadedCommit != commit)
            {
                return;
            }

            if (!string.IsNullOrWhiteSpace(markdown))
            {
                // Raw HTML is stripped and link URL schemes are whitelisted (see MarkdownRenderer).
                _readme = (MarkupString)MarkdownRenderer.ToSafeHtml(markdown);
            }
        }
        catch
        {
            if (_loadedCommit != commit)
            {
                return; // a slow failure for a version the user left must not clear the new one
            }

            _readme = null;
        }

        // AssetData/ file tree (what actually gets cloned): precomputed in the index for the
        // latest version — no api.github.com call (60 req/h/IP anonymous breaks easily behind a
        // shared NAT). Older/certified versions still fall back to the GitHub API.
        if (_loadedCommit != commit)
        {
            return;
        }

        if (commit == asset.Latest.Commit && asset.Latest.Files.Count > 0)
        {
            var indexed = asset.Latest.Files.Select(f => (f.Path, Size: f.SizeBytes)).ToList();
            _fileCount = indexed.Count;
            _fileTree = BuildTree(indexed);
            return;
        }

        var treeApi = GitLinks.TreeApi(asset.Repo, commit);
        if (treeApi is not null)
        {
            try
            {
                using var request = new HttpRequestMessage(HttpMethod.Get, treeApi);
                request.Headers.UserAgent.ParseAdd("StrideAssetStore"); // GitHub's API requires a User-Agent
                using var response = await Http.SendAsync(request);
                if (_loadedCommit != commit)
                {
                    return;
                }

                if (response.IsSuccessStatusCode)
                {
                    using var doc = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
                    var files = doc.RootElement.GetProperty("tree").EnumerateArray()
                        .Where(e => e.GetProperty("type").GetString() == "blob"
                            && e.GetProperty("path").GetString()!.StartsWith("AssetData/", StringComparison.Ordinal))
                        .Select(e => (
                            Path: e.GetProperty("path").GetString()!["AssetData/".Length..],
                            Size: e.TryGetProperty("size", out var sz) ? sz.GetInt64() : 0L))
                        .ToList();
                    _fileCount = files.Count;
                    _fileTree = files.Count > 0 ? BuildTree(files) : null;
                }
            }
            catch
            {
                if (_loadedCommit != commit)
                {
                    return;
                }

                _fileTree = null;
                _fileCount = 0;
            }
        }
    }

    private static TreeNode BuildTree(IEnumerable<(string Path, long Size)> files)
    {
        var root = new TreeNode { IsFolder = true };
        foreach (var (path, size) in files)
        {
            var parts = path.Split('/');
            var node = root;
            for (var i = 0; i < parts.Length; i++)
            {
                var isFile = i == parts.Length - 1;
                if (!node.Children.TryGetValue(parts[i], out var child))
                {
                    child = new TreeNode { Name = parts[i], IsFolder = !isFile };
                    node.Children[parts[i]] = child;
                }

                if (isFile)
                {
                    child.Size = size;
                }

                node = child;
            }
        }

        return root;
    }

    // Folders first (open by default), then files; recurses into subfolders.
    private RenderFragment RenderNode(TreeNode node) => @<text>
        @foreach (var child in node.Children.Values.OrderByDescending(c => c.IsFolder).ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase))
        {
            @if (child.IsFolder)
            {
                <details class="tree-folder">
                    <summary><span class="tree-ico">📁</span> @child.Name</summary>
                    <div class="tree-children">@RenderNode(child)</div>
                </details>
            }
            else
            {
                <div class="tree-file">
                    <span class="mono"><span class="tree-ico">📄</span> @child.Name</span>
                    <span class="mono filesize">@FormatSize(child.Size)</span>
                </div>
            }
        }
    </text>;

    // thumbnail/media paths are relative to the repository root (display-only, not cloned into projects).
    private string? ThumbUrl =>
        Asset is not null && !string.IsNullOrEmpty(Asset.Manifest.Thumbnail)
            ? GitLinks.RawRepoFile(Asset.Repo, Asset.Latest.Commit, Asset.Manifest.Thumbnail)
            : null;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.EnsureLoadedAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Copy(string text) => await Env.CopyAsync(text);

    private static string FormatSize(long bytes) => ByteSize.Format(bytes);

    public void Dispose() => State.Changed -= OnChanged;
}
