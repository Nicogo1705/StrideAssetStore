@page "/download"
@inject AppInfo App
@inject IJSRuntime JS
@inject UpdateService Updater

<PageTitle>Download the desktop app — Community Stride Asset Store</PageTitle>

<a class="back" href="">← Back to catalog</a>
<h1 style="margin:.2rem 0 .3rem">Download the desktop app</h1>
<p class="lead">
    The desktop app adds one-click <strong>install</strong> into your Stride projects and the
    <strong>My projects</strong> manager. Each build is <strong>self-contained</strong> — no .NET install
    required. You only need <strong>git</strong> on your <code>PATH</code> to clone assets.
</p>

@* First on the page on purpose: the tool owns a single install location and drives updates from
   the terminal, so getting the app this way still works when the app's own UI doesn't. *@
<section class="panel">
    <h2>Recommended: install from a terminal</h2>
    <ul class="steps">
        <li><code>dotnet tool install -g StrideAssetStore</code></li>
        <li><code>strideassetstore app install</code> — fetches the build for your machine</li>
        <li><code>strideassetstore app update</code> — the way to update it afterwards</li>
    </ul>
    <p>
        The tool keeps the app in one known location and updates it from outside, so you never end
        up with several copies and an update still works when the app's own interface doesn't.
    </p>
    <p>
        It also installs assets into your project without the app at all — same shared cache, same
        portable project reference: <code>strideassetstore search grass</code>,
        <code>strideassetstore add grass</code>, <code>strideassetstore update</code>.
    </p>
    <p class="install-hint">
        Needs the .NET SDK and <code>git</code> on your <code>PATH</code>.
        <a href="https://www.nuget.org/packages/StrideAssetStore" target="_blank" rel="noopener">Package on NuGet ↗</a>
    </p>
</section>

<h2 style="margin:1.6rem 0 .3rem">Or download the archive</h2>
<p class="lead">
    The manual alternative when you'd rather not install the .NET SDK. Updating then means coming
    back here for the next archive.
</p>

<p class="dl-version">
    @if (Updater.LatestVersion is { } latest)
    {
        <text>Latest release: <strong>v@(latest)</strong> — <a href="@GitLinks.ReleasesLatest(App.Repo)" target="_blank" rel="noopener">release notes ↗</a></text>
    }
    else
    {
        <text>Every download tracks the <a href="@GitLinks.Releases(App.Repo)" target="_blank" rel="noopener">latest release</a>.</text>
    }
</p>

<section class="dl-grid">
    @foreach (var b in DesktopBuilds.All)
    {
        // Only the first build for the detected OS is flagged (arch isn't detectable in the browser).
        var recommended = b.Os == _os && b == DesktopBuilds.All.FirstOrDefault(x => x.Os == _os);
        <a class="dl-card @(recommended ? "recommended" : "")"
           href="@GitLinks.LatestAssetDownload(App.Repo, b.AssetName)">
            @if (recommended)
            {
                <span class="dl-ribbon">Your OS</span>
            }
            <span class="dl-os">@Icon(b.Os)</span>
            <span class="dl-label">@b.Label</span>
            <span class="dl-file mono">@b.AssetName</span>
            @if (Updater.LatestVersion is { } ver)
            {
                <span class="dl-ver-badge">v@(ver)</span>
            }
            <span class="dl-cta">⬇ Download</span>
        </a>
    }
</section>
<p class="install-hint dl-note">
    Every link points to the <strong>latest</strong> release.
    <a href="@GitLinks.Releases(App.Repo)" target="_blank" rel="noopener">All releases &amp; changelog ↗</a>
</p>

<section class="panel">
    <h2>Run it</h2>
    <ol class="steps">
        <li>Unpack the archive anywhere.</li>
        <li>Run <code>StrideAssetStore.Desktop</code> (<code>.exe</code> on Windows). It starts a local server and opens your browser at <code>http://localhost:5111</code>.</li>
        <li>On macOS/Linux you may need to mark it executable first: <code>chmod +x StrideAssetStore.Desktop</code>. On macOS, right-click → Open the first time to bypass Gatekeeper (the build is unsigned).</li>
    </ol>
    <p class="install-hint">
        Updating is a terminal job: <code>strideassetstore app update</code>. The app tells you when
        a release is out, but it never replaces itself.
    </p>
</section>

<section class="panel">
    <h2>Verify your download</h2>
    <p>
        Builds are unsigned, so each release ships a
        <a href="@GitLinks.LatestAssetDownload(App.Repo, "SHA256SUMS")">SHA256SUMS</a> file.
        Compare it with your archive's checksum:
    </p>
    <ul class="steps">
        <li>Windows: <code>certutil -hashfile StrideAssetStore-win-x64.zip SHA256</code></li>
        <li>macOS/Linux: <code>shasum -a 256 -c SHA256SUMS</code> (in the download folder)</li>
    </ul>
</section>

@code {
    private string _os = "unknown";

    protected override async Task OnInitializedAsync() => await Updater.CheckAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _os = await JS.InvokeAsync<string>("assetStoreEnv.os");
            StateHasChanged();
        }
        catch
        {
            // detection is optional — all builds are still listed
        }
    }

    private static string Icon(string os) => os switch
    {
        "windows" => "🪟",
        "macos" => "🍎",
        "linux" => "🐧",
        _ => "💻",
    };
}
