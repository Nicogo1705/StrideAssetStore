@page "/projects/install"
@implements IDisposable
@inject CatalogState State
@inject AssetInstaller Installer
@inject ProjectStore Store
@inject StrideAssetStore.Core.Local.Git.ForkLister Forks

@if (Asset is null)
{
    <a class="back" href="">← Back</a>
    <p class="notice">@(string.IsNullOrEmpty(Id) ? "No asset specified." : $"Asset '{Id}' not found.")</p>
}
else
{
    <PageTitle>Install @Asset.Manifest.Name</PageTitle>
    <a class="back" href="@($"a/{Uri.EscapeDataString(Asset.Id)}")">← Back to @Asset.Manifest.Name</a>
    <h1 style="margin:.2rem 0 1rem">Install @Asset.Manifest.Name</h1>

    @if (Asset.Manifest.Nuget is not null)
    {
        <section class="panel">
            <h2>Import mode</h2>
            <div class="modes" role="tablist">
                <button class="mode @(IsNuget ? "" : "active")" role="tab" @onclick='() => SetImport("local")'>Source &amp; ProjectReference</button>
                <button class="mode @(IsNuget ? "active" : "")" role="tab" @onclick='() => SetImport("nuget")'>NuGet package</button>
            </div>
            <p class="mode-desc">
                @(IsNuget
                    ? "Adds a <PackageReference> to the published package — no source is cloned."
                    : "Clones the source and adds a <ProjectReference> — you can compile and tweak it locally.")
            </p>
        </section>
    }

    @if (IsNuget)
    {
        <section class="panel">
            <p class="install-hint">NuGet install — adds <span class="mono">&lt;PackageReference Include="@Asset.Manifest.Nuget!.PackageId"@(Asset.Manifest.Nuget.PackageVersion is { } pv ? $" Version=\"{pv}\"" : "") /&gt;</span> to the projects you pick. No source is cloned.</p>
        </section>
    }
    else
    {
        <section class="panel">
            <h2>Version</h2>
            <label class="field">
                <select class="ipt" @bind="_ref">
                    <option value="@Asset.Latest.Ref">latest — @Asset.Latest.Ref branch (rolling)</option>
                    @foreach (var v in Asset.Versions)
                    {
                        <option value="@v.Tag">@v.Version — tag@(IsCertified(v.Commit) ? " ✓ certified" : "")</option>
                    }
                </select>
            </label>
            <p class="install-hint">
                @if (_ref == Asset.Latest.Ref)
                {
                    <text>Rolling <strong>@Asset.Latest.Ref</strong> — newest commit, not certified.</text>
                }
                else if (IsCertified(Asset.Versions.FirstOrDefault(v => v.Tag == _ref)?.Commit ?? ""))
                {
                    <text>✓ Certified release — reviewed &amp; pinned to an immutable commit.</text>
                }
                else
                {
                    <text>Tag <strong>@_ref</strong> — pinned, not certified.</text>
                }
            </p>
        </section>

        @* Which code, not which project: this belongs next to the version, and applies to the
           shared download as much as to a project install. *@
        <section class="panel">
            <h2>Source</h2>
            <label class="check">
                <input type="radio" name="assetsource" checked="@(!_useFork)" @onchange="() => _useFork = false" />
                <span>The official asset
                    <span class="install-hint">— from the registry: certified versions, content hash verified.</span></span>
            </label>
            <label class="check">
                <input type="radio" name="assetsource" checked="@_useFork" @onchange="SelectForkSource" />
                <span>A fork
                    <span class="install-hint">— someone else's copy, with its own versions.</span></span>
            </label>
            @if (_useFork)
            {
                <div style="margin:.3rem 0 0 1.7rem;max-width:34rem">
                    @if (_loadingForks)
                    {
                        <span class="install-hint">Looking for forks…</span>
                    }
                    else if (_forks.Count > 0)
                    {
                        @* One control at a time: the list and a free-text box side by side showed the
                           same value twice, both truncated. *@
                        <select class="ipt" style="width:100%" title="@_fork" value="@ForkChoice" @onchange="OnForkChoiceChanged">
                            @foreach (var f in _forks)
                            {
                                <option value="@f.FullName">@f.FullName@(f.Stars > 0 ? $" · ★ {f.Stars}" : "")</option>
                            }
                            <option value="@OtherFork">Another repository…</option>
                        </select>
                    }
                    @if (_forkOther || (!_loadingForks && _forks.Count == 0))
                    {
                        <input class="ipt" style="width:100%;margin-top:.3rem" placeholder="owner/repo" @bind="_fork" />
                    }
                </div>
                @if (!_loadingForks && _forks.Count == 0)
                {
                    <p class="install-hint" style="margin:.2rem 0 0 1.7rem">No fork of this asset on GitHub — type one if you have it elsewhere.</p>
                }
                <p class="install-hint" style="margin:.35rem 0 0 1.7rem">
                    ⚠ <strong>Fork — outside the store.</strong> The content hash isn't verified and no
                    certification applies: you are trusting whoever owns that repository. It is cached
                    separately, so the official asset stays untouched.
                </p>
            }
        </section>
    }

    @if (!IsNuget)
    {
        <section class="panel">
            <h2>Install as shared asset</h2>
            <p class="install-hint" style="margin-top:0">
                No project needed — download <strong>@_ref</strong> (and its dependencies) into the shared
                cache only. Attach it to a project later from <a href="projects">My projects</a>
                (＋ Add a downloaded asset), or manage it in <a href="assets">My assets</a>.
            </p>
            @* Same trap as the install button: "a fork" with nothing typed would quietly download the
               official asset instead. *@
            <button class="btn" @onclick="DoDownloadOnly"
                    disabled="@(_busy || (_useFork && string.IsNullOrWhiteSpace(_fork)))">
                @(_busy ? "Downloading…" : "⇩ Download to shared cache")
            </button>
        </section>
    }

    <section class="panel">
        <h2>@(IsNuget ? "Choose a project" : "…or install into a project")</h2>
        @if (_tracked.Count > 0)
        {
            <p class="install-hint">Your tracked projects (managed in <a href="projects">My projects</a>):</p>
            <div class="pick-list">
                @foreach (var t in _tracked)
                {
                    var path = t.Path;
                    <button class="pick-row @(string.Equals(path, _picked, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                            @onclick="() => PickPath(path)" disabled="@(!t.Exists)">
                        <span class="mp-ico">@(t.IsSolution ? "🧩" : "📄")</span>
                        <span class="pick-name">@t.Name</span>
                        @if (!t.Exists)
                        {
                            <span class="badge" style="color:var(--warn);border-color:var(--warn)">missing</span>
                        }
                        <span class="install-hint pick-path">@path</span>
                    </button>
                }
            </div>
        }
        else
        {
            <p class="install-hint">No tracked projects yet — browse for one below and it'll be remembered in <a href="projects">My projects</a>.</p>
        }

        @if (_browsing || _tracked.Count == 0)
        {
            <p class="install-hint" style="margin-top:.6rem">Browse for a <span class="mono">.sln</span>/<span class="mono">.slnx</span> — it's added to My projects automatically:</p>
            <FileBrowser FilesSelectable="true" SolutionsOnly="true" StorageKey="assetstore.install.dir" OnFilePicked="OnPicked" />
        }
        else
        {
            <button class="btn" style="margin-top:.6rem" @onclick="() => _browsing = true">＋ Browse for another project…</button>
        }
    </section>

    @if (_picked is not null && _targets.Count == 0)
    {
        <section class="panel">
            <p class="notice">No C# projects found in that file. Pick a <span class="mono">.sln</span>/<span class="mono">.slnx</span> or a <span class="mono">.csproj</span>.</p>
        </section>
    }

    @if (_targets.Count > 0)
    {
        <section class="panel">
            <h2>Target projects</h2>
            <p class="install-hint"><span class="mono">@_picked</span></p>
            @if (!IsNuget)
            {
                @if (SelectedIsCertified)
                {
                    <div class="cache-note" style="color:var(--ok)">
                        ✓ Certified version — reviewed by the registry maintainers and pinned to an immutable
                        commit. Its source is still compiled into your project like any dependency.
                    </div>
                }
                else
                {
                    <div class="cache-note">
                        ⚠ <strong>Unreviewed source.</strong> This version is not certified: nobody has reviewed
                        its code (including custom MSBuild targets) for the registry. It is cloned into your
                        solution and <strong>runs as part of your build</strong> — only install assets whose
                        authors you trust, or pick a ✓ certified version above when one exists.
                    </div>
                }
            }
            @foreach (var p in _targets.Where(p => _showPlatform || !IsPlatformHead(p.Name)))
            {
                <label class="check">
                    <input type="checkbox" checked="@_checked.Contains(p.Path)"
                           @onchange="e => Toggle(p.Path, (bool)e.Value!)" />
                    @p.Name <span class="install-hint">@p.Path</span>
                </label>
            }
            @{
                var platformCount = _targets.Count(p => IsPlatformHead(p.Name));
            }
            @if (platformCount > 0)
            {
                <button class="btn" style="margin-top:.3rem" @onclick="() => _showPlatform = !_showPlatform">
                    @(_showPlatform ? "Hide" : "Show") platform projects (@platformCount)
                </button>
            }

            @if (!IsNuget)
            {
                <p class="install-hint">
                    The asset and its dependencies are cloned into the shared cache below, and the reference
                    written into your project resolves there on any machine — commit it, and teammates just
                    download the asset. To own and modify an asset instead, fork it.
                </p>
                <p class="mono install-hint">@AssetInstaller.GlobalCacheRoot</p>

            }

            <button class="btn primary" style="margin-top:.8rem" @onclick="DoInstall" disabled="@(_busy || _checked.Count == 0 || (_useFork && string.IsNullOrWhiteSpace(_fork)))">
                @(_busy ? "Installing…" : IsNuget ? $"Add package to {_checked.Count} project(s)" : $"Install into {_checked.Count} project(s)")
            </button>
        </section>
    }

    @if (_result is not null)
    {
        <section class="panel">
            <h2>@(_result.Success ? "✓ Done" : "✗ Failed")</h2>
            <ul class="problems" style="color:var(--text)">
                @foreach (var m in _result.Messages)
                {
                    <li>@m</li>
                }
            </ul>
        </section>
    }

}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "id")]
    public string? Id { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "mode")]
    public string? Mode { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "ref")]
    public string? Ref { get; set; }


    private string _importMode = "local"; // "local" | "nuget" — switchable when the asset publishes a package
    private string _ref = "main";
    private string? _picked;
    private bool _busy;

    // Install from someone's fork rather than the asset's own repository.
    private bool _useFork;
    private string _fork = "";
    private bool _loadingForks;
    private bool _forkOther;

    private const string OtherFork = "__other";

    /// <summary>What the list should show: the picked fork, or the escape hatch.</summary>
    private string ForkChoice => _forkOther || !_forks.Any(f => f.FullName == _fork) ? OtherFork : _fork;

    private void OnForkChoiceChanged(ChangeEventArgs e)
    {
        var value = (string?)e.Value ?? "";
        _forkOther = value == OtherFork;
        _fork = _forkOther ? "" : value;
    }
    private IReadOnlyList<StrideAssetStore.Core.Local.Git.AssetFork> _forks = [];

    /// <summary>
    /// Loads the asset's forks the first time "a fork" is picked — one API call, and only for
    /// someone who actually asked. Preselects the first, so the choice is never left half-made.
    /// </summary>
    private async Task SelectForkSource()
    {
        _useFork = true;
        if (Asset is null || _loadingForks)
        {
            return;
        }

        if (_forks.Count == 0)
        {
            _loadingForks = true;
            try
            {
                _forks = await Forks.ListAsync(Asset.Repo);
            }
            finally
            {
                _loadingForks = false;
            }
        }

        if (string.IsNullOrWhiteSpace(_fork))
        {
            _fork = _forks.FirstOrDefault()?.FullName ?? "";
        }
    }
    private bool _browsing;
    private bool _showPlatform;

    // Stride generates a per-platform head project (…​.Windows/.Linux/.Android/.iOS); assets go in the core
    // game project, not the heads, so those are hidden by default.
    private static readonly string[] StridePlatformSuffixes =
        [".Windows", ".Linux", ".Android", ".iOS", ".macOS", ".UWP"];

    private static bool IsPlatformHead(string name) =>
        StridePlatformSuffixes.Any(s => name.EndsWith(s, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<TrackedProject> _tracked = [];
    private List<SolutionProject> _targets = [];
    private readonly HashSet<string> _checked = new(StringComparer.OrdinalIgnoreCase);
    private InstallResult? _result;

    private IndexedAsset? Asset => string.IsNullOrEmpty(Id) ? null : State.Find(Id);

    private bool IsNuget =>
        string.Equals(_importMode, "nuget", StringComparison.OrdinalIgnoreCase) && Asset?.Manifest.Nuget is not null;

    private bool IsCertified(string commit) =>
        Asset is not null && !string.IsNullOrEmpty(commit)
        && Asset.Certified.Any(c => string.Equals(c.Commit, commit, StringComparison.Ordinal));

    /// <summary>Whether the ref picked in the Version panel resolves to a certified commit
    /// (the rolling latest branch counts too, if it currently sits on one).</summary>
    private bool SelectedIsCertified =>
        Asset is { } a && IsCertified(
            _ref == a.Latest.Ref ? a.Latest.Commit : a.Versions.FirstOrDefault(v => v.Tag == _ref)?.Commit ?? "");

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnChanged;
        await State.EnsureLoadedAsync();
        ResolveRef();
        _tracked = Store.List();
    }

    protected override void OnParametersSet()
    {
        ResolveRef();

        // Seed the import mode from the query (?mode=), but the user can switch it below.
        _importMode = string.Equals(Mode, "nuget", StringComparison.OrdinalIgnoreCase) && Asset?.Manifest.Nuget is not null
            ? "nuget"
            : "local";

        _picked = null;
        _targets = [];
        _checked.Clear();
        _result = null;
    }

    // Pre-select the version carried over from the asset page (?ref=), falling back to latest.
    private void ResolveRef()
    {
        if (Asset is null)
        {
            _ref = "main";
            return;
        }

        _ref = !string.IsNullOrEmpty(Ref) && (Ref == Asset.Latest.Ref || Asset.Versions.Any(v => v.Tag == Ref))
            ? Ref
            : Asset.Latest.Ref;
    }

    private void SetImport(string mode)
    {
        _importMode = mode;
        _result = null;
    }

    private void OnCloneDirChanged(string? dir)
    {
        if (!string.IsNullOrEmpty(dir))
        {
        }
    }

    // A project picked from the file browser is remembered in My projects, so both entry points
    // (browse once vs. pick a tracked project) converge on the same list afterwards.
    private void OnPicked(FsEntry e)
    {
        Store.Add(e.Path);
        _tracked = Store.List();
        _browsing = false;
        PickPath(e.Path);
    }

    // Single code path for choosing a target, whether from a tracked project or the browser.
    private void PickPath(string path)
    {
        _picked = path;
        try
        {
            _targets = Installer.ReadTargets(path).ToList();
        }
        catch
        {
            _targets = [];
        }

        _checked.Clear(); // let the user choose which projects to add the reference to
    }

    private void Toggle(string path, bool on)
    {
        if (on) _checked.Add(path); else _checked.Remove(path);
    }

    // "Install as shared asset": clone into the versioned cache (Assets\<ref>\...) with no project
    // wiring at all — the clone is picked up later via My projects' attach or the My assets page.
    private async Task DoDownloadOnly()
    {
        _busy = true;
        _result = null;
        var asset = Asset!;
        var reference = _ref;
        var catalog = State.Catalog!.Assets.ToDictionary(a => a.Id, StringComparer.Ordinal);
        var fork = _useFork && !string.IsNullOrWhiteSpace(_fork) ? _fork.Trim() : null;
        var result = await Task.Run(() => Installer.DownloadToCache(asset, catalog, solutionPath: null, refFolder: reference, fork: fork));
        _result = result.Success
            ? result with { Messages = [.. result.Messages, "Shared asset ready — attach it to a project from My projects whenever you like."] }
            : result;
        _busy = false;
    }

    private async Task DoInstall()
    {
        _busy = true;
        _result = null;
        var asset = Asset!;
        var reference = _ref;
        var targets = _checked.ToList();
        var nuget = IsNuget;
        var solution = _picked; // the picked .sln/.slnx (or lone .csproj) — asset projects get added to it
        var catalog = State.Catalog!.Assets.ToDictionary(a => a.Id, StringComparer.Ordinal);
        // Run the blocking git/IO work off the render thread so the "Installing…" state shows.
        _result = await Task.Run(() => nuget
            ? Installer.InstallNuget(asset, targets)
            : Installer.Install(asset, reference, targets, catalog, solution,
                _useFork && !string.IsNullOrWhiteSpace(_fork) ? _fork.Trim() : null));
        _busy = false;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= OnChanged;
}
