<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Community Stride Asset Store</title>
    @* Versioned: the page markup ships inside the assembly, this stylesheet does not, and a browser
       holding on to the previous one styles new markup with old rules. *@
    <link rel="stylesheet" href="@($"_content/StrideAssetStore.UI/app.css?v={AssetVersion}")" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <div id="components-reconnect-modal" class="reconnect-modal">
        <div class="reconnect-card">
            <div class="reconnect-spinner"></div>
            <div class="reconnect-title">Reconnecting…</div>
            <div class="reconnect-sub">The Community Stride Asset Store lost its connection — retrying.</div>
            @* The top bar's 🖥/⏻ buttons need the (now dead) circuit; these plain links don't. *@
            <div class="rescue-row">
                @if (OperatingSystem.IsWindows())
                {
                    <a class="rescue-btn" href="/console/toggle">🖥 Console</a>
                }
                <a class="rescue-btn" href="/app/quit">⏻ Quit</a>
                <a class="rescue-btn" href="">↻ Reload</a>
            </div>
        </div>
    </div>

    @* Shown by Blazor when the circuit dies on an unhandled error. Without it the page just
       freezes: every button, including quit and the console toggle, stops responding. *@
    <div id="blazor-error-ui">
        <span class="dismiss" title="Dismiss"
              onclick="document.getElementById('blazor-error-ui').style.display='none'">🗙</span>
        <strong>Something went wrong in the page.</strong>
        The app itself is still running — reload, or use the controls below.
        <span class="rescue-row">
            <a class="rescue-btn reload" href="">↻ Reload</a>
            @if (OperatingSystem.IsWindows())
            {
                <a class="rescue-btn" href="/console/toggle">🖥 Console</a>
            }
            <a class="rescue-btn" href="/app/quit">⏻ Quit</a>
        </span>
    </div>

    @* Versioned like the stylesheet, and for a sharper reason: this file's contract changes with the
       C# that calls it — assetStoreEnv.copy started returning a boolean, and a browser holding the
       previous one makes every copy button report failure. *@
    <script src="@($"_content/StrideAssetStore.UI/js/interop.js?v={AssetVersion}")"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    /// <summary>
    /// Cache-busting token for the static assets that ship outside the assembly. A released build
    /// uses its version; a local build has a fixed one (0.0.0 in Debug, 99.0.0 in Release), which
    /// would never change and leave a developer editing CSS against a cached copy — so those fall
    /// back to the build time of the assembly itself.
    /// </summary>
    private static readonly string AssetVersion = ResolveAssetVersion();

    private static string ResolveAssetVersion()
    {
        var assembly = System.Reflection.Assembly.GetEntryAssembly();
        var version = assembly?.GetName().Version;
        if (version is not null && version.Major is not (0 or 99))
        {
            return version.ToString(3);
        }

        try
        {
            return File.GetLastWriteTimeUtc(assembly!.Location).Ticks.ToString();
        }
        catch
        {
            return "dev";
        }
    }
}
