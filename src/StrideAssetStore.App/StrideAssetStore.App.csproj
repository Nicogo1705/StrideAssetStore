<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrideAssetStore.Core\StrideAssetStore.Core.csproj" />
    <ProjectReference Include="..\StrideAssetStore.UI\StrideAssetStore.UI.csproj" />
  </ItemGroup>

  <!-- Same guard as the UI library: nothing that needs a real machine may reach the browser. -->
  <Target Name="_ForbidCoreLocalReference" AfterTargets="ResolveReferences">
    <Error Condition="'%(ReferencePath.Filename)' == 'StrideAssetStore.Core.Local'"
           Text="$(MSBuildProjectName) must not reference StrideAssetStore.Core.Local: it runs in the browser, where there is no filesystem and no git." />
  </Target>

</Project>
